AddType image/x-icon .ico
AddType image/png .png
AddType image/jpeg .jpg

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical origin is https://matejkadlec.cz (no www, no plain HTTP)
    RewriteCond %{HTTP_HOST} ^www\.matejkadlec\.cz [NC]
    RewriteRule ^(.*)$ https://matejkadlec.cz/$1 [L,R=301]

    RewriteCond %{HTTP_HOST} ^matejkadlec\.cz$ [NC]
    RewriteCond %{REQUEST_SCHEME} =http
    RewriteRule ^ https://matejkadlec.cz%{REQUEST_URI} [L,R=301]

    # Former portrait URL (published as og:image and in structured data)
    RewriteRule ^assets/img/portrait\.png$ /assets/img/matej-kadlec.jpg [L,R=301]

    RewriteRule ^favicon\.ico$ /assets/img/favicon/favicon.ico [L]
    RewriteRule ^index(?:\.html)?/?$ / [R=301,L]
    # Strip .html from the path only (a ".html" in the query string, e.g.
    # ?ref=page.html, must not trigger it); NE keeps %-escapes as they came
    RewriteCond %{THE_REQUEST} \s/([^?\s]*?)\.html/?[?\s] [NC]
    RewriteRule ^ /%1 [NE,L,R=301]

    # Drop trailing slashes from non-directory URLs (/about-me/ -> /about-me)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    RewriteRule ^o-mne/?$ /about-me.html [NC,L]

    # Serve extensionless top-level pages from their .html files
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^[^/]+$ %{REQUEST_URI}.html [NC,L]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # CSS and JS are referenced with a ?v= version; bump it when they change
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Images and fonts: give a replaced file a new name
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Pages and CVs are always revalidated (cheap 304s), so updates show up
    # immediately after a deploy. "Header set" only touches successful
    # responses, so redirects stay cacheable.
    <FilesMatch "\.(html|pdf)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
